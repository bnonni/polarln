{
  "name": "polarln",
  "version": "0.1.0",
  "description": "Polar Lightning client methods, CLI, and node credentials, over the Polar v4 HTTP bridge or on Docker",
  "keywords": [
    "bitcoin",
    "lightning-network",
    "polar",
    "polar-lightning",
    "regtest"
  ],
  "homepage": "https://github.com/bnonni/polarln",
  "bugs": {
    "url": "https://github.com/bnonni/polarln/issues"
  },
  "license": "Unlicense",
  "author": {
    "name": "Bryan Nonni",
    "url": "https://github.com/bnonni"
  },
  "contributors": [
    {
      "name": "Bryan Nonni",
      "url": "https://github.com/bnonni"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bnonni/polarln.git"
  },
  "bin": {
    "polarln": "./dist/cli.js"
  },
  "files": [
    "dist",
    "protos",
    "src",
    "NOTICE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "check-cli": "pnpm build && bun scripts/check_cli.ts",
    "check-docker": "bun scripts/check_docker.ts",
    "check-tools": "bun scripts/check_tools.ts",
    "clean": "rimraf dist coverage",
    "format": "oxfmt",
    "lint": "oxlint --type-aware --deny-warnings && oxfmt --check",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build",
    "sync-protos": "sh scripts/sync_protos.sh",
    "test": "tsc -p tsconfig.test.json && BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 sh scripts/with_temp_home.sh bun test",
    "wipe": "rimraf node_modules"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
